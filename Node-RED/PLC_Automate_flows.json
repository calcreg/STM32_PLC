    {
        "id": "7623d6dd852fc067",
        "type": "function",
        "z": "5048fdb1707ef592",
        "name": "Machine State",
        "func": "// Keep a persistent context or combine incoming signals\n// For example, if you trigger this function whenever any output changes:\n// DEBUG: See what is actually arriving from the PLC\n//node.warn(\"Incoming Topic: \" + msg.topic + \" | Payload: \" + JSON.stringify(msg.payload));\n\ncontext.set(\"machineState\", context.get(\"machineState\") || {\n    relay1: false,\n    relay2: false,\n    relay3: false,\n    relay4: false,\n    motorpwm1: 0,\n    motorpwm2: 0,\n    btn1: false,\n    btn2: false,\n    btn3: false\n});\n\nlet state = context.get(\"machineState\");\n\n// Update the specific output based on the topic or incoming msg\n\nif (msg.topic === \"polling_qx\") {\n    state.relay1 = msg.payload[0];\n    state.relay2 = msg.payload[1];\n    state.relay3 = msg.payload[2];\n    state.relay4 = msg.payload[3];\n}\nelse if (msg.topic === \"polling_qw\") {\n    state.motorpwm1 = msg.payload[0];\n    state.motorpwm2 = msg.payload[1];\n}\nelse if (msg.topic === \"polling_inputs\"){\n    state.btn1 = msg.payload[0];\n    state.btn2 = msg.payload[1];\n    state.btn3 = msg.payload[2];\n}\nmsg.payload = state;\nreturn msg;",
