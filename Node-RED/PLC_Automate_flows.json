    {
        "id": "438392b94f241e17",
        "type": "ui_template",
        "z": "5048fdb1707ef592",
        "group": "970ec5ee8f9ecf7e",
        "name": "PLC Automate",
        "order": 2,
        "width": 0,
        "height": 0,
        "format": "<div\n    style=\"position: relative; width: 100%; max-width: 258px; height: 320px; background: #1e293b; border-radius: 12px; border: 2px solid #334155; color: #f8fafc; font-family: sans-serif; box-shadow: 0 6px 15px rgba(0,0,0,0.4); overflow: hidden; margin: 0 auto;\">\n\n    <!-- ================= BACKGROUND IMAGE ================= -->\n    <img src=\"/img/PLC_Automate.jpg\" style=\"position: absolute; top: 0; left: 0; width: 100%; height: 100%; opacity: 0.5; object-fit: cover; z-index: 0;\">\n\n    <!-- ================= CONTENT WRAPPER (Handles Padding) ================= -->\n    <div\n        style=\"position: relative; width: 100%; height: 100%; padding: 15px; box-sizing: border-box; z-index: 1; display: flex; flex-direction: column;\">\n\n         <!-- ================= SPOT 1: Relay1 (%QX0.0) ================= -->\n        <div style=\"position: absolute; top: 235px; left: 20px; display: flex; align-items: center; gap: 8px;\">\n            <div style=\"\n                width: 16px; \n                height: 16px; \n                border-radius: 50%; \n                border: 2px solid #fff;\n                background-color: {{ (msg.payload && msg.payload.relay1) ? '#00FF00' : '#333333' }};\n                box-shadow: {{ (msg.payload && msg.payload.relay1) ? '0 0 12px #00FF00' : 'none' }};\n                transition: all 0.2s ease-in-out;\">\n            </div>\n            <span style=\"font-size: 13px; font-weight: 600;\">R1</span>\n        </div>\n\n        <!-- ================= SPOT 2: Relay2 (%QX0.1) ================= -->\n        <div style=\"position: absolute; top: 194px; left: 20px; display: flex; align-items: center; gap: 8px;\">\n            <div style=\"\n                width: 16px; \n                height: 16px; \n                border-radius: 50%; \n                border: 2px solid #fff;\n                background-color: {{ (msg.payload && msg.payload.relay2) ? '#00FF00' : '#333333' }};\n                box-shadow: {{ (msg.payload && msg.payload.Relay2) ? '0 0 12px #00FF00' : 'none' }};\n                transition: all 0.2s ease-in-out;\">\n            </div>\n            <span style=\"font-size: 13px; font-weight: 600;\">R2</span>\n        </div>\n\n        <!-- ================= SPOT 3: Relay3 (%QX0.2) ================= -->\n        <div style=\"position: absolute; top: 147px; left: 20px; display: flex; align-items: center; gap: 8px;\">\n            <div style=\"\n                width: 16px; \n                height: 16px; \n                border-radius: 50%; \n                border: 2px solid #fff;\n                background-color: {{ (msg.payload && msg.payload.relay3) ? '#EF4444' : '#333333' }};\n                box-shadow: {{ (msg.payload && msg.payload.Relay3) ? '0 0 12px #EF4444' : 'none' }};\n                transition: all 0.2s ease-in-out;\">\n            </div>\n            <span style=\"font-size: 13px; font-weight: 600;\">R3</span>\n        </div>\n\n        <!-- ================= SPOT 4: Relay4 (%QX0.3) ================= -->\n        <div style=\"position: absolute; top: 106px; left: 20px; display: flex; align-items: center; gap: 8px;\">\n            <div style=\"\n                width: 16px; \n                height: 16px; \n                border-radius: 50%; \n                border: 2px solid #fff;\n                background-color: {{ (msg.payload && msg.payload.relay4) ? '#EF4444' : '#333333' }};\n                box-shadow: {{ (msg.payload && msg.payload.Relay4) ? '0 0 12px #EF4444' : 'none' }};\n                transition: all 0.2s ease-in-out;\">\n            </div>\n            <span style=\"font-size: 13px; font-weight: 600;\">R4</span>\n        </div>\n\n        <!-- ================= SPOT 5: Motor PWM (motorpwm1) ================= -->\n            <div style=\"position: absolute; top: 63px; left: 20px; display: flex; align-items: center; gap: 8px;\">\n                <div style=\"\n                            width: 16px; \n                            height: 16px; \n                            border-radius: 50%; \n                            border: 2px solid #fff;\n                            background-color: {{ \n                                !msg.payload || msg.payload.motorpwm1 === 0 ? '#000000' : \n                                msg.payload.motorpwm1 < 7500 ? '#006400' : \n                                msg.payload.motorpwm1 < 15000 ? '#00FF00' : \n                                msg.payload.motorpwm1 <= 32000 ? '#EAB308' : \n                                msg.payload.motorpwm1 <= 48000 ? '#B91C1C' : '#EF4444' \n                            }};\n                            box-shadow: {{ \n                                !msg.payload || msg.payload.motorpwm1 === 0 ? 'none' : \n                                '0 0 12px ' + (\n                                    msg.payload.motorpwm1 < 7500 ? '#006400' : \n                                    msg.payload.motorpwm1 < 15000 ? '#00FF00' : \n                                    msg.payload.motorpwm1 <= 32000 ? '#EAB308' : \n                                    msg.payload.motorpwm1 <= 48000 ? '#B91C1C' : '#EF4444'\n                                )\n                            }};\n                            transition: all 0.2s ease-in-out;\">\n                </div>\n                <span style=\"font-size: 13px; font-weight: 600;\">PWM1 ({{ (msg.payload.motorpwm1*100/65535).toFixed(1) || 0 }}%)</span>\n            </div>\n<!-- ================= SEMI-CIRCULAR GAUGE FOR PWM1 ================= -->\n<div style=\"position: absolute; top: 8x; left: 170px; width: 90px; text-align: center; z-index: 1;\">\n    <svg viewBox=\"0 0 100 55\" style=\"width: 100%; overflow: visible;\">\n        <!-- Background Track Arc (20% opacity) -->\n        <path d=\"M 10 50 A 40 40 0 0 1 90 50\" fill=\"none\" stroke=\"#334155\" stroke-width=\"8\" stroke-linecap=\"round\" style=\"opacity: 0.2;\" />\n        \n        <!-- Dynamic Foreground Value Arc (50% opacity via CSS style) -->\n        <path d=\"M 10 50 A 40 40 0 0 1 90 50\" fill=\"none\" \n              stroke=\"{{ \n                  !msg.payload || msg.payload.motorpwm1 < 22000 ? '#00FF00' : \n                  msg.payload.motorpwm1 < 45000 ? '#EAB308' : '#EF4444' \n              }}\" \n              stroke-width=\"8\" stroke-linecap=\"round\"\n              stroke-dasharray=\"125.6\"\n              stroke-dashoffset=\"{{ 125.6 - (125.6 * ((msg.payload.motorpwm1 || 0) / 65535)) }}\"\n              style=\"opacity: 0.9; transition: stroke-dashoffset 0.3s ease, stroke 0.3s ease;\" />\n        \n        <!-- Center Text: Percentage & Value (100% opaque for readability) -->\n        <text x=\"50\" y=\"38\" text-anchor=\"middle\" fill=\"#f8fafc\" font-size=\"11\" font-weight=\"bold\" font-family=\"sans-serif\">\n            {{ (((msg.payload.motorpwm1 || 0) * 100) / 65535).toFixed(0) }}%\n        </text>\n    </svg>\n    <div style=\"font-size: 11px; font-weight: 600; color: #cbd5e1; margin-top: -5px;\">Motor Speed</div>\n</div>\n        <!-- ================= SPOT 6: Motor PWM2 (%QX0.5) ================= -->\n        <div style=\"position: absolute; top: 12px; left: 20px; display: flex; align-items: center; gap: 8px;\">\n            <div style=\"\n                width: 16px; \n                height: 16px; \n                border-radius: 50%; \n                border: 2px solid #fff;\n                background-color: {{ (msg.payload && msg.payload.pwm2) ? '#EF4444' : '#333333' }};\n                box-shadow: {{ (msg.payload && msg.payload.pwm2) ? '0 0 12px #EF4444' : 'none' }};\n                transition: all 0.2s ease-in-out;\">\n            </div>\n            <span style=\"font-size: 13px; font-weight: 600;\">PWM2</span>\n        </div>\n\n        <!-- ================= INPUT 1: btn1 (%IX0.0) ================= -->\n        <div style=\"position: absolute; top: 225px; left: 198px; display: flex; align-items: center; gap: 8px;\">\n            <div style=\"\n                width: 28px; \n                height: 28px; \n                border-radius: 50%; \n                border: 2px solid #333;\n                {{ (msg.payload && msg.payload.btn1) ? 'background-color: #00FF00' : '' }};\n                transition: all 0.2s ease-in-out;\">\n            </div>\n        </div>\n       <!-- ================= INPUT 2: btn2 (%IX0.1) ================= -->\n        <div style=\"position: absolute; top: 225px; left: 145px; display: flex; align-items: center; gap: 8px;\">\n            <div style=\"\n                width: 28px; \n                height: 28px; \n                border-radius: 50%; \n                border: 2px solid #333;\n                {{ (msg.payload && msg.payload.btn2) ? 'background-color: #FF0000' : '' }};\n                transition: all 0.2s ease-in-out;\">\n            </div>\n        </div>\n        <!-- ================= INPUT 3: btn3 (%IX0.2) ================= -->\n        <div style=\"position: absolute; top: 225px; left: 90px; display: flex; align-items: center; gap: 8px;\">\n            <div style=\"\n                width: 28px; \n                height: 28px; \n                border-radius: 50%; \n                border: 2px solid #333;\n                {{ (msg.payload && msg.payload.btn3) ? 'background-color: #FFFF00' : '' }};\n                transition: all 0.2s ease-in-out;\">\n            </div>\n        </div>         \n    </div>\n</div>",
        "storeOutMessages": true,
        "fwdInMessages": true,
        "resendOnRefresh": true,
        "templateScope": "local",
